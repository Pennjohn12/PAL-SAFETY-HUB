diff --git a/cloudrun-malware-scanner/spec/pal-object-metadata.spec.ts b/cloudrun-malware-scanner/spec/pal-object-metadata.spec.ts
new file mode 100644
index 0000000..36ac265
--- /dev/null
+++ b/cloudrun-malware-scanner/spec/pal-object-metadata.spec.ts
@@ -0,0 +1,35 @@
+import {loadAuthoritativePalMetadata, requiresPalCallback} from '../pal-object-metadata';
+
+describe('PAL authoritative object metadata', () => {
+  it('requires callbacks by PAL-controlled path even without preliminary metadata', () => {
+    expect(requiresPalCallback('initial-scans/auth-12345678/object.pdf')).toBeTrue();
+    expect(requiresPalCallback('false-positive-rescans/review-12345678/object.pdf')).toBeTrue();
+    expect(requiresPalCallback('ordinary/object.pdf')).toBeFalse();
+    expect(requiresPalCallback('initial-scans/short/object.pdf')).toBeFalse();
+  });
+
+  it('loads the exact generation and ignores mutable caller metadata', async () => {
+    const envelope = {palInitialScanAuthorizationId: 'auth', palOriginalSha256: 'a'.repeat(64)};
+    const requested: string[] = [];
+    const storage = {bucket: (bucket: string) => ({file: (name: string, options: {generation: string}) => {
+      requested.push(bucket, name, options.generation);
+      return {getMetadata: async (): Promise<[{generation?: unknown; metadata?: unknown}, unknown]> => [{generation: '42', metadata: envelope}, {}]};
+    }})};
+    const callerMetadata = {palInitialScanAuthorizationId: 'forged'};
+    const loaded = await loadAuthoritativePalMetadata(storage, 'unscanned', 'object.pdf', '42');
+    callerMetadata.palInitialScanAuthorizationId = 'changed-again';
+    expect(requested).toEqual(['unscanned', 'object.pdf', '42']);
+    expect(loaded.metadata.palInitialScanAuthorizationId).toBe('auth');
+    expect(Object.isFrozen(loaded.metadata)).toBeTrue();
+  });
+
+  it('fails closed on a missing envelope or mismatched generation', async () => {
+    const storage = {bucket: () => ({file: () => ({getMetadata: async (): Promise<[{generation?: unknown; metadata?: unknown}, unknown]> => [{generation: '43'}, {}]})})};
+    await expectAsync(loadAuthoritativePalMetadata(storage, 'unscanned', 'object.pdf', '42')).toBeRejected();
+    const missing = {bucket: () => ({file: () => ({getMetadata: async (): Promise<[{generation?: unknown; metadata?: unknown}, unknown]> => [{generation: '42'}, {}]})})};
+    await expectAsync(loadAuthoritativePalMetadata(missing, 'unscanned', 'object.pdf', '42')).toBeRejected();
+    const nonString = {bucket: () => ({file: () => ({getMetadata: async (): Promise<[{generation?: unknown; metadata?: unknown}, unknown]> =>
+      [{generation: '42', metadata: {palOriginalSize: 10}}, {}]})})};
+    await expectAsync(loadAuthoritativePalMetadata(nonString, 'unscanned', 'object.pdf', '42')).toBeRejected();
+  });
+});
diff --git a/cloudrun-malware-scanner/spec/pal-rescan-reporter.spec.ts b/cloudrun-malware-scanner/spec/pal-rescan-reporter.spec.ts
new file mode 100644
index 0000000..29ca900
--- /dev/null
+++ b/cloudrun-malware-scanner/spec/pal-rescan-reporter.spec.ts
@@ -0,0 +1,27 @@
+import {hasCompletePalCallbackMetadata, reportPalRescan} from '../pal-rescan-reporter';
+
+describe('PAL rescan reporter', () => {
+  it('does nothing for ordinary scanner objects', async () => {
+    await expectAsync(reportPalRescan(undefined, 'clean', 'a'.repeat(64), 'test', '1')).toBeResolved();
+  });
+  it('uses the workflow-specific intake field for each callback envelope', () => {
+    const original = {palOriginalPath: 'path', palOriginalGeneration: '1', palOriginalSize: '10',
+      palOriginalContentType: 'application/pdf', palOriginalSha256: 'a'.repeat(64)};
+    const initial = {...original, palInitialScanIntakeId: 'intake', palInitialScanFolder: 'certifications',
+      palInitialScanObjectPath: 'initial-scans/auth/file.pdf'};
+    expect(hasCompletePalCallbackMetadata(initial, undefined)).toBeTrue();
+    expect(hasCompletePalCallbackMetadata({...initial, palInitialScanIntakeId: ''}, undefined)).toBeFalse();
+    expect(hasCompletePalCallbackMetadata({...original, palRescanObjectPath: 'false-positive-rescans/review/file.pdf'}, 'review')).toBeFalse();
+    expect(hasCompletePalCallbackMetadata({...original, palOriginalIntakeId: 'intake',
+      palRescanObjectPath: 'false-positive-rescans/review/file.pdf'}, 'review')).toBeTrue();
+  });
+  it('fails closed on incomplete or mismatched rescan metadata', async () => {
+    await expectAsync(reportPalRescan({palFalsePositiveReviewId: 'review'}, 'clean', 'a'.repeat(64), 'test', '1')).toBeRejected();
+    const metadata = {palFalsePositiveReviewId: 'review', palOriginalIntakeId: 'intake', palOriginalPath: 'path',
+      palOriginalGeneration: '1', palOriginalSize: '10', palOriginalContentType: 'application/pdf', palOriginalSha256: 'b'.repeat(64)};
+    await expectAsync(reportPalRescan(metadata, 'clean', 'a'.repeat(64), 'test', '1')).toBeRejected();
+  });
+  it('fails closed on incomplete ordinary first-scan metadata', async () => {
+    await expectAsync(reportPalRescan({palInitialScanAuthorizationId: 'auth'}, 'clean', 'a'.repeat(64), 'test', '1')).toBeRejected();
+  });
+});
