diff --git a/cloudrun-malware-scanner/pal-object-metadata.ts b/cloudrun-malware-scanner/pal-object-metadata.ts
new file mode 100644
index 0000000..2990c91
--- /dev/null
+++ b/cloudrun-malware-scanner/pal-object-metadata.ts
@@ -0,0 +1,27 @@
+type MetadataFile = {
+  getMetadata(): Promise<[{generation?: unknown; metadata?: unknown}, unknown]>;
+};
+
+type MetadataStorage = {
+  bucket(name: string): {file(name: string, options: {generation: string}): MetadataFile};
+};
+
+export function requiresPalCallback(name: string): boolean {
+  if (!name || name.length > 1024) return false;
+  return /^(initial-scans|false-positive-rescans)\/[^/]{8,180}\/[^/]{1,180}$/.test(name);
+}
+
+export async function loadAuthoritativePalMetadata(storage: MetadataStorage, bucket: string, name: string,
+  generation: string): Promise<{generation: string; metadata: Readonly<Record<string, string>>}> {
+  if (!bucket || !name || !/^\d+$/.test(generation)) throw new Error('PAL scan object generation is invalid');
+  const exactFile = storage.bucket(bucket).file(name, {generation});
+  const [current] = await exactFile.getMetadata();
+  const currentGeneration = String(current.generation ?? '');
+  if (currentGeneration !== generation) throw new Error('PAL scan object generation changed');
+  const custom = current.metadata;
+  if (!custom || typeof custom !== 'object' || Array.isArray(custom)) throw new Error('PAL scan object metadata is missing');
+  const entries = Object.entries(custom);
+  if (!entries.length || entries.length > 32 || entries.some(([key, value]) => !key || key.length > 120
+      || typeof value !== 'string' || !value || value.length > 2048)) throw new Error('PAL scan object metadata is invalid');
+  return {generation: currentGeneration, metadata: Object.freeze(Object.fromEntries(entries))};
+}
diff --git a/cloudrun-malware-scanner/pal-rescan-reporter.ts b/cloudrun-malware-scanner/pal-rescan-reporter.ts
new file mode 100644
index 0000000..a6e944d
--- /dev/null
+++ b/cloudrun-malware-scanner/pal-rescan-reporter.ts
@@ -0,0 +1,31 @@
+import {GoogleAuth} from 'google-auth-library';
+
+const ORIGINAL_OBJECT = ['palOriginalPath', 'palOriginalGeneration', 'palOriginalSize',
+  'palOriginalContentType', 'palOriginalSha256'] as const;
+
+export function hasCompletePalCallbackMetadata(metadata: Record<string, string> | undefined, reviewId: string | undefined): boolean {
+  const required = reviewId ? ['palOriginalIntakeId', ...ORIGINAL_OBJECT, 'palRescanObjectPath'] : [...ORIGINAL_OBJECT,
+    'palInitialScanIntakeId', 'palInitialScanFolder', 'palInitialScanObjectPath'];
+  return required.every((key) => metadata?.[key]);
+}
+
+export async function reportPalRescan(metadata: Record<string, string> | undefined, result: 'clean' | 'infected', sha256: string,
+  clamVersion: string, scanObjectGeneration: string): Promise<void> {
+  const reviewId = metadata?.palFalsePositiveReviewId;
+  const authorizationId = metadata?.palInitialScanAuthorizationId;
+  if (!reviewId && !authorizationId) return;
+  const callback = reviewId ? process.env.PAL_RESCAN_CALLBACK_URL : process.env.PAL_INITIAL_SCAN_CALLBACK_URL;
+  if (!callback || !hasCompletePalCallbackMetadata(metadata, reviewId)) throw new Error('PAL scan callback metadata is incomplete');
+  if (!/^[a-f0-9]{64}$/.test(sha256) || !Number.isSafeInteger(Number(metadata?.palOriginalSize))
+      || Number(metadata?.palOriginalSize) < 1 || !/^\d+$/.test(scanObjectGeneration)) throw new Error('PAL scan object identity is invalid');
+  if (metadata?.palOriginalSha256 !== sha256) throw new Error('PAL scan digest does not match the exact original object');
+  const client = await new GoogleAuth().getIdTokenClient(callback);
+  const data = reviewId ? { reviewId, rescanObjectPath: metadata?.palRescanObjectPath, result, sha256, clamVersion,
+    scannedAt: new Date().toISOString(), originalIdentity: { path: metadata?.palOriginalPath, generation: metadata?.palOriginalGeneration,
+      size: Number(metadata?.palOriginalSize), contentType: metadata?.palOriginalContentType, sha256: metadata?.palOriginalSha256 }
+  } : { authorizationId, intakeId: metadata?.palInitialScanIntakeId, folder: metadata?.palInitialScanFolder,
+    scanObjectPath: metadata?.palInitialScanObjectPath, scanObjectGeneration, result, sha256, clamVersion,
+    scannedAt: new Date().toISOString(), originalIdentity: { path: metadata?.palOriginalPath, generation: metadata?.palOriginalGeneration,
+      size: Number(metadata?.palOriginalSize), contentType: metadata?.palOriginalContentType, sha256: metadata?.palOriginalSha256 } };
+  await client.request({ url: callback, method: 'POST', timeout: 15000, data });
+}
