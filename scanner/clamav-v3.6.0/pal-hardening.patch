@@ -16 +16 @@
-FROM node:24.15.0-alpine AS node
+FROM node:24.15.0-alpine@sha256:d1b3b4da11eefd5941e7f0b9cf17783fc99d9c6fc34884a665f40a06dbdfc94f AS node
@@ -19 +19 @@ FROM node:24.15.0-alpine AS node
-FROM gcr.io/google.com/cloudsdktool/google-cloud-cli:alpine AS gcloud-cli
+FROM gcr.io/google.com/cloudsdktool/google-cloud-cli:alpine@sha256:9309b9c14eaa55728e508d98e9971919ace5cb931582cacf9c7d040a077b5953 AS gcloud-cli
@@ -22 +22 @@ FROM gcr.io/google.com/cloudsdktool/google-cloud-cli:alpine AS gcloud-cli
-FROM clamav/clamav:1.5.2_base
+FROM clamav/clamav:1.5.2_base@sha256:3aa0c6d6a966dc062899e070fb13f87485acf0cbb710fccaae9a848cd5f5b09a
@@ -87,0 +88,6 @@ COPY .  /app
+# Normalize the executable startup script inside the Linux image so a Windows
+# checkout cannot introduce CRLF bytes that Bash interprets as commands.
+RUN sed -i 's/\r$//' bootstrap.sh \
+    && ! grep -q "$(printf '\r')" bootstrap.sh \
+    && bash -n bootstrap.sh
+
@@ -89 +95,5 @@ COPY .  /app
-RUN npm ci && npm run build && npm ci --omit=dev
+RUN npm ci \
+    && npm run build \
+    && npm ci --omit=dev \
+    && rm -rf /root/.npm /usr/local/lib/node_modules/npm \
+    && rm -f /usr/local/bin/npm /usr/local/bin/npx
