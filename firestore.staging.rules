rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verifiedEmail() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function safeEmployeeBootstrap(userId) {
      return verifiedEmail()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'role',
          'accessLevel',
          'admin',
          'isAdmin',
          'disabled',
          'environment',
          'synthetic'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'employee'
        && request.resource.data.accessLevel == 'employee'
        && request.resource.data.admin == false
        && request.resource.data.isAdmin == false
        && request.resource.data.disabled == false
        && request.resource.data.environment == 'staging'
        && request.resource.data.synthetic == true;
    }

    match /users/{userId} {
      allow get: if verifiedEmail() && request.auth.uid == userId;
      allow list: if false;
      allow create: if safeEmployeeBootstrap(userId);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
