rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verifiedEmail() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function safeEmployeeBootstrap(userId) {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'role',
          'accessLevel',
          'admin',
          'isAdmin',
          'disabled',
          'environment',
          'synthetic'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'employee'
        && request.resource.data.accessLevel == 'employee'
        && request.resource.data.admin == false
        && request.resource.data.isAdmin == false
        && request.resource.data.disabled == false
        && request.resource.data.environment == 'staging'
        && request.resource.data.synthetic == true;
    }

    function profile() {
      return signedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
    }

    function activeSyntheticProfile() {
      return verifiedEmail()
        && profile().environment == 'staging'
        && (profile().synthetic == true || profile().synthetic == 'true')
        && profile().get('status', '') != 'disabled-test';
    }

    function syntheticProjectMember(project) {
      return activeSyntheticProfile()
        && project.environment == 'staging'
        && project.synthetic == 'true'
        && request.auth.uid in [
          project.employeeUid,
          project.foremanUid,
          project.supervisorUid,
          project.officeUid,
          project.adminUid
        ];
    }

    match /users/{userId} {
      allow get: if verifiedEmail() && request.auth.uid == userId;
      allow list: if false;
      allow create: if safeEmployeeBootstrap(userId);
      allow update, delete: if false;
    }

    match /projects/{projectId} {
      allow get: if syntheticProjectMember(resource.data);
      allow list, create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
